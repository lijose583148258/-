<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ime_panel_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ime_status_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="Keyboard ready"
        android:textColor="#1E3A35"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/previewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/ime_preview_background"
        android:minHeight="60dp"
        android:padding="12dp"
        android:text="@string/ime_empty_preview"
        android:textColor="#1E3A35"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/directionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ime_button_secondary"
            android:text="ZH -> VI"
            android:textAllCaps="false"
            android:textColor="#1E3A35" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ime_button_secondary"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="#1E3A35" />
    </LinearLayout>

    <Button
        android:id="@+id/translateSelectionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/ime_button_primary"
        android:text="Translate selection and insert"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/translateClipboardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ime_button_secondary"
        android:text="Translate clipboard and insert"
        android:textAllCaps="false"
        android:textColor="#1E3A35" />

    <Button
        android:id="@+id/insertLastButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ime_button_secondary"
        android:text="Insert last result again"
        android:textAllCaps="false"
        android:textColor="#1E3A35" />

</LinearLayout>
